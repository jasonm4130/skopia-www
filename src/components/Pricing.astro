---
import CostChart from './CostChart.astro';
---
<!-- PRICING -->
<section class="sec pricing" id="pricing" aria-labelledby="price-h">
  <div class="wrap">
    <h2 id="price-h" class="h-label">What it costs to run</h2>
    <p class="price-say">At <output class="mono out" id="calc-pv" for="calc-slider">500K</output> pageviews a month, Cloudflare bills you <output class="mono out" id="calc-cost" for="calc-slider">$0</output>. Skopia itself is&nbsp;free.</p>
    <div class="calc">
      <div class="chart"><CostChart /></div>
      <div class="slider-row" style="--l:4.400%;--w:94.200%;--lm:9.444%;--wm:87.778%">
        <label for="calc-slider" class="sr">Monthly pageviews</label>
        <input id="calc-slider" type="range" min="0" max="1000" step="1" value="515" aria-describedby="calc-note" aria-valuetext="500K pageviews, $0 a month">
      </div>
      <div class="calc-foot">
        <p class="calc-note" id="calc-note" aria-live="polite">Inside Cloudflare's free tier, which covers roughly 0.9M pageviews a month.</p>
        <p class="calc-aside">Past 20M, add roughly $0.55 per extra million. The software is AGPL-3.0 with every feature unlocked: unlimited sites and events, realtime, geography, custom events and full export.</p>
      </div>
    </div>
  </div>
</section>
